{
  "name": "Web Extension Options Demo",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Example Web Extension demonstrating web-extension-options",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "node_modules/web-extension-options/sounds/*.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

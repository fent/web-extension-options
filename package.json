{
  "name": "web-extension-options",
  "main": "dist/main.min.js",
  "version": "1.0.0",
  "description": "Options page for your Web Extension",
  "author": "fent (https://github.com/fent)",
  "keywords": [
    "webextension",
    "extension",
    "options",
    "chrome",
    "firefox"
  ],
  "homepage": "https://github.com/fent/web-extension-options",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/web-extension-options.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "sounds",
    "options.html"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "build:zip": "node scripts/build-zip.js",
    "watch": "node scripts/build.js --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "npm run build",
    "test": "nyc --reporter=lcov --reporter=text-summary mocha --exit test/*-test.js"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "assets": [
            "web-extension-options.zip"
          ]
        }
      ]
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "c-p": "github:tovic/color-picker#1722fec9b8564eaf3b56b00a2b608d29ce129087",
    "chrome-bootstrap": "^1.5.0",
    "esbuild": "^0.25.0",
    "istanbul-lib-coverage": "^3.2.2",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "puppeteer": "^25.16.0",
    "snarkdown": "^2.0.0",
    "v8-to-istanbul": "^9.3.0"
  }
}
